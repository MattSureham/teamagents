# Agent Meetings portable settings
#
# Browser agents in the default config do not require API keys. If you add an
# API-based agent to config/meetings.config.yml, enter its key below.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
MINIMAX_API_KEY=
QWEN_API_KEY=
MOONSHOT_API_KEY=
KIMI_API_KEY=

# Optional local endpoints
LMSTUDIO_ENDPOINT=http://127.0.0.1:1234/v1
VLLM_ENDPOINT=http://127.0.0.1:8000/v1
